# Messaging provider: "console" prints SMS to the terminal (local dev),
# "telnyx" sends real SMS via Telnyx
MESSAGING_PROVIDER=console
TELNYX_API_KEY=                # Telnyx Mission Control → API Keys (starts with KEY)
TELNYX_PUBLIC_KEY=             # Mission Control → Keys & Credentials → Public Key (base64, for webhook verification)
TELNYX_PHONE_NUMBER=           # Your Telnyx number in E.164, e.g. +15551234567

# Google OAuth (Gmail read-only scanning)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=           # e.g. http://localhost:3001/api/auth/callback

# Anthropic (Claude Haiku email parsing)
ANTHROPIC_API_KEY=

# Security
JWT_SECRET=                    # openssl rand -hex 32
ENCRYPTION_KEY=                # openssl rand -hex 32 (AES-256-GCM key for OAuth tokens at rest)

# Database (local SQLite file, or Turso URL + auth token in prod)
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=           # only needed for Turso

# App
NEXT_PUBLIC_APP_URL=http://localhost:3001
CRON_SECRET=                   # openssl rand -hex 32 (authorizes /api/cron/* routes)
